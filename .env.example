# Copy to .env and fill in real values. NEVER commit .env.
# All values below are placeholders.

NODE_ENV=development

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- PostgreSQL ---
# POSTGRES_* are read by infra/compose/docker-compose.dev.yml
POSTGRES_USER=bitabar
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bitabar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bitabar:CHANGE_ME@localhost:5432/bitabar

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_TTL_SECONDS=1209600

# --- Column encryption (AES-256-GCM, base64 32-byte key) ---
FIELD_ENCRYPTION_KEY=CHANGE_ME

# --- Integrations (Mock in v1) ---
SMS_PROVIDER=mock
SMS_API_KEY=
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
