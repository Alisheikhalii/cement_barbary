# Copy to .env and fill in real values. NEVER commit .env.
# All values below are placeholders.

NODE_ENV=development

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- PostgreSQL ---
# POSTGRES_* are read by infra/compose/docker-compose.dev.yml
POSTGRES_USER=bitabar
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bitabar
POSTGRES_PORT=5432
# Runtime role (bitabar_app): the API connects with this; RLS tenant isolation applies.
DATABASE_URL=postgresql://bitabar_app:CHANGE_ME_APP@localhost:5432/bitabar
# Schema owner — used ONLY by `pnpm --filter @bitabar/api db:migrate`, never by the app.
DATABASE_MIGRATION_URL=postgresql://bitabar:CHANGE_ME@localhost:5432/bitabar
# Password of the runtime role for local dev; used only by infra/scripts/db-app-user.sh.
APP_DB_PASSWORD=CHANGE_ME_APP
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth (F1-04, ADR-007) ---
# AUTH_TOKEN_SECRET (HS256 key) arrives with T05. Numbers below are config, not magic
# constants; the Argon2 values cannot go below the OWASP floor (startup fails).
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_TIME=2
AUTH_ARGON2_PARALLELISM=1
# Progressive per-account login delay: base × 2^(failures-1), capped.
AUTH_LOCK_BASE_SECONDS=1
AUTH_LOCK_MAX_SECONDS=300
# Login rate limits (fixed 60 s windows).
AUTH_RL_LOGIN_IP_PER_MIN=20
AUTH_RL_LOGIN_TENANT_PER_MIN=60
AUTH_ACCESS_TOKEN_TTL_SECONDS=600
# Operator-set one-time password lifetime (hours).
AUTH_TEMP_PASSWORD_TTL_HOURS=24

# --- PII column encryption (AES-256-GCM) + blind index (HMAC-SHA256) ---
# Generate EACH key separately with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The two keys MUST be different; startup refuses otherwise (ADR-006 U10).
PII_ENC_KEY=CHANGE_ME_base64_of_32_random_bytes
PII_HMAC_KEY=CHANGE_ME_base64_of_32_random_bytes
PII_KEY_ID=1

# --- Integrations (Mock in v1) ---
SMS_PROVIDER=mock
SMS_API_KEY=
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
